# ==============================================================================
# REFERENCE ARCHITECTURE ONLY — DO NOT RENAME TO render.yaml
#
# IMPORTANT NOTICE FOR REPOSITORY MAINTAINERS:
# This file is an example blueprint and reference template for deploying Nexus CRM
# on Render. If a Render service and PostgreSQL database already exist, do NOT
# rename this file to render.yaml or connect a Blueprint, as Render Blueprint sync
# can provision duplicate databases, reset environment variables, or trigger
# accidental service replacement. Reuse your existing service and database!
#
# STORAGE & MIGRATIONS ARCHITECTURE:
# - No paid persistent disk is required: Site inspection photos and documents are
#   persisted using STORAGE_DRIVER=s3 with a free object storage bucket
#   (e.g., Cloudflare R2 / AWS S3 free tier).
# - No Render pre-deploy command: Database migrations are executed by hand from
#   the administrator's local machine before deployment.
# ==============================================================================

services:
  - type: web
    name: nexus-crm
    runtime: node
    plan: free # No paid persistent disk required; runs on standard Render Web Service
    branch: main
    buildCommand: npm ci && npm run build
    startCommand: npm run start:backend
    healthCheckPath: /api/health
    envVars:
      # Node runtime & service configuration
      - key: NODE_ENV
        value: production
      - key: PORT
        value: "10000"
      - key: SITE_INSPECTION_GATE
        value: "off" # Start with "off" during initial deploy/verification; remove to enforce gate

      # Storage Driver (S3-compatible object storage; no local disk needed)
      - key: STORAGE_DRIVER
        value: s3
      - key: S3_BUCKET
        sync: false
      - key: S3_REGION
        sync: false
      - key: S3_ENDPOINT
        sync: false
      - key: S3_ACCESS_KEY_ID
        sync: false
      - key: S3_SECRET_ACCESS_KEY
        sync: false
      - key: S3_FORCE_PATH_STYLE
        sync: false

      # Database & Authentication (Secrets - sync: false, configured in Render Dashboard)
      - key: DATABASE_URL
        sync: false
      - key: JWT_SECRET
        sync: false
      - key: CORS_ORIGIN
        sync: false

      # Integrations & Omnichannel Communications (Secrets - sync: false)
      - key: TWILIO_ACCOUNT_SID
        sync: false
      - key: TWILIO_AUTH_TOKEN
        sync: false
      - key: TWILIO_WHATSAPP_NUMBER
        sync: false
      - key: TWILIO_PHONE_NUMBER
        sync: false
      - key: TWILIO_VERIFY_TOKEN
        sync: false
      - key: WHATSAPP_VERIFY_TOKEN
        sync: false
      - key: LINKEDIN_CLIENT_ID
        sync: false
      - key: LINKEDIN_CLIENT_SECRET
        sync: false
      - key: LINKEDIN_ACCESS_TOKEN
        sync: false
      - key: META_APP_ID
        sync: false
      - key: META_APP_SECRET
        sync: false
      - key: META_ACCESS_TOKEN
        sync: false
      - key: INSTAGRAM_VERIFY_TOKEN
        sync: false
      - key: INSTAGRAM_APP_SECRET
        sync: false
      - key: GMAIL_CLIENT_ID
        sync: false
      - key: GMAIL_CLIENT_SECRET
        sync: false
      - key: GMAIL_REDIRECT_URI
        sync: false
      - key: GMAIL_ENCRYPTION_KEY
        sync: false
      - key: SMTP_HOST
        sync: false
      - key: SMTP_PORT
        sync: false
      - key: SMTP_SECURE
        sync: false
      - key: SMTP_USER
        sync: false
      - key: SMTP_PASS
        sync: false
      - key: SMTP_FROM
        sync: false
      - key: GROQ_API_KEY
        sync: false
      - key: GEMINI_API_KEY
        sync: false
      - key: OPENROUTER_API_KEY
        sync: false
      - key: ANTHROPIC_API_KEY
        sync: false
      - key: INBOUND_EMAIL_SECRET
        sync: false
      - key: AI_MODERATION_PROVIDER
        sync: false
      - key: COMPANY_NAME
        sync: false
      - key: BASE_URL
        sync: false
      - key: LEAD_RESPONSE_SLA_HOURS
        sync: false
      - key: QUOTE_FOLLOWUP_DAYS
        sync: false
      - key: INTENT_FILTER_MODE
        sync: false
      - key: INTENT_FILTER_CHANNELS
        sync: false
      - key: INTENT_MODEL
        sync: false
      - key: INTENT_CREATE_MIN
        sync: false
      - key: INTENT_REVIEW_MIN
        sync: false
      - key: INTENT_AI_TIMEOUT_MS
        sync: false
      - key: INTERNAL_DOMAINS
        sync: false
      - key: INTENT_ATTACH_WINDOW_DAYS
        sync: false
      - key: INTENT_AUTOREPLY_ENABLED
        sync: false
      - key: INTENT_AUTOREPLY_COOLDOWN_DAYS
        sync: false
      - key: BUSINESS_DESCRIPTION
        sync: false
