# =================================================================
# NEXUS ENTERPRISE CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server & Database
PORT=5506
USE_SQLITE=true
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_crm
RUN_SYNC=false

# Security & Auth
JWT_SECRET=change_me_to_a_secure_random_string
CORS_ORIGIN=http://localhost:5173

# WhatsApp Business API (Meta Cloud API v18.0)
WHATSAPP_TOKEN=your_meta_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=nexus_whatsapp_webhook_secret_2026

# LinkedIn InMail API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Instagram / Meta Business API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token

# Gmail OAuth & Sync
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:5173/settings
GMAIL_ENCRYPTION_KEY=nexus_crm_default_encryption_key_2026

# SMTP Server Config
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Nexus CRM" <no-reply@nexus-crm.com>

# Inbound Webhook Authorization
INBOUND_EMAIL_SECRET=your_secure_inbound_secret_token_here

# AI Sales Copilot (Anthropic API Key)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SLA & Enterprise Config
COMPANY_NAME="Nexus Automation Systems Ltd"
BASE_URL=http://localhost:5506
LEAD_RESPONSE_SLA_HOURS=24
QUOTE_FOLLOWUP_DAYS=5

# Twilio Telephony (Click-to-Call & Call Recording)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12025550123

