# =================================================================
# NEXUS ENTERPRISE CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server & Database
PORT=5506
USE_SQLITE=true
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_crm
RUN_SYNC=false

# Security & Auth
JWT_SECRET=change_me_to_a_secure_random_string
CORS_ORIGIN=http://localhost:5173

# Twilio Omnichannel WhatsApp & Telephony
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+14155238886
# Webhook verification token — must match what you set in Twilio Console → Webhook URL
TWILIO_VERIFY_TOKEN=your_twilio_webhook_verify_token_here
# WhatsApp Business API webhook verify token (used by inbound webhook handler)
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here

# LinkedIn InMail API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Instagram / Meta Business API (Used for Facebook & Instagram Lead Capture)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token

# Gmail OAuth & Sync
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:5173/settings
GMAIL_ENCRYPTION_KEY=nexus_crm_default_encryption_key_2026

# SMTP Server Config
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Nexus CRM" <no-reply@nexus-crm.com>

# FREE LLM API KEYS (Pick any one or leave empty to use built-in free DB parser)
# Option A: Groq API (100% Free - Llama 3.3 70B - Get key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Option B: Google Gemini API (100% Free - Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Option C: OpenRouter API (100% Free - Get key at https://openrouter.ai/keys - uses :free models e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Inbound Webhook Authorization
INBOUND_EMAIL_SECRET=your_secure_inbound_secret_token_here

# AI Sales Copilot (Anthropic API Key)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SLA & Enterprise Config
COMPANY_NAME="Nexus Automation Systems Ltd"
BASE_URL=http://localhost:5506
LEAD_RESPONSE_SLA_HOURS=24
QUOTE_FOLLOWUP_DAYS=5

# Instagram Webhook Config
INSTAGRAM_VERIFY_TOKEN=your_secure_instagram_verify_token_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here
